# Variáveis para o agente Luna no OpenBot (NÃO coloque valores reais no git).
# Guarde a chave no cofre do OpenBot (openbot.request_api_key → "Only this agent").

# URL pública do Luna Finance (sem barra no fim)
LUNA_API_URL=https://seu-dominio-do-luna
# Base da API de integração (derivada da anterior)
LUNA_OPENBOT_BASE=${LUNA_API_URL}/api/integrations/openbot/v1
# Credencial criada em Configurações → Integrações → OpenBot (começa com lfo_; aparece uma única vez)
LUNA_OPENBOT_API_KEY=lfo_xxxxxxxx_coloque-aqui-pelo-cofre-do-openbot
# Opcional: tempo máximo por chamada (ms) usado pelo servidor MCP
LUNA_TIMEOUT_MS=15000
