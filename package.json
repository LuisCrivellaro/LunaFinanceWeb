{
  "name": "luna-finance",
  "version": "1.0.0",
  "private": true,
  "description": "Luna Finance — gestão financeira familiar (web + bot do Telegram)",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p server/tsconfig.json",
    "build:web": "tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx server/src/scripts/migrate.ts",
    "family:setup": "tsx server/src/scripts/setup-family.ts",
    "family:reset-link": "tsx server/src/scripts/reset-link.ts",
    "telegram:set-webhook": "tsx server/src/scripts/telegram-webhook.ts set",
    "telegram:webhook-info": "tsx server/src/scripts/telegram-webhook.ts info",
    "telegram:delete-webhook": "tsx server/src/scripts/telegram-webhook.ts delete",
    "backup": "tsx server/src/scripts/backup.ts",
    "restore": "tsx server/src/scripts/restore.ts",
    "demo:seed": "tsx server/src/scripts/demo-seed.ts",
    "telegram:poll": "tsx server/src/scripts/telegram-poll.ts",
    "e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
