# =====================================================================
# Luna Finance — variáveis de ambiente
# Copie para `.env` (nunca faça commit do .env) e preencha.
# =====================================================================

# development | production
NODE_ENV=development
PORT=3000

# URL pública do site. Em produção precisa ser https:// (exigência do Telegram).
APP_URL=http://localhost:5173

# Banco de dados (Postgres). Em desenvolvimento, sem isto, usa PGlite em .data/luna
# Ex.: postgresql://usuario:senha@host:5432/luna?sslmode=require
DATABASE_URL=

# Fuso usado para "hoje", vencimentos e horários das notificações
APP_TIMEZONE=America/Sao_Paulo

# Sessão (dias) e tentativas de login por IP a cada 15 min
SESSION_DAYS=30
LOGIN_RATE_MAX=20

# Atrás de proxy/load balancer (Render, Railway, Fly, Nginx): true
TRUST_PROXY=false

# ---------------------------- Telegram ----------------------------
# Token gerado pelo @BotFather (formato 123456789:AA...). SEGREDO.
TELEGRAM_BOT_TOKEN=
# Nome de usuário do bot, sem @ (ex.: LunaFinanceFamiliaBot)
TELEGRAM_BOT_USERNAME=
# Segredo aleatório (32+ caracteres: A-Z a-z 0-9 _ -) que o Telegram envia em
# cada chamada do webhook. Gere com:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------- Agendador ----------------------------
# Notificações e recorrências rodam dentro do servidor a cada 10 min.
SCHEDULER_ENABLED=true
# Opcional: segredo para um cron externo chamar POST /api/cron/run
# (útil se a hospedagem "dorme"). Gere com: openssl rand -hex 32
CRON_SECRET=

# ---------------------------- IA (opcional) ----------------------------
# Só interpreta frases que as regras não entenderam. Nunca calcula valores.
ANTHROPIC_API_KEY=
LUNA_AI_MODEL=claude-opus-5-5
LUNA_AI_ENABLED=true
